# Install ROOT-OWNED with visudo -cf validation; never grant arbitrary sudo/bash.
# Deployment may control only application services and read-only migration status.
# Database migrations deliberately require the administrator, not this account.
glampro-deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart glampro-api.service, /usr/bin/systemctl stop glampro-api.service, /usr/bin/systemctl restart glampro-worker.service, /usr/bin/systemctl stop glampro-worker.service, /usr/bin/systemctl restart glampro-migration-status.service
