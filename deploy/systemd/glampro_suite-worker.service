[Unit]
Description=Glampro worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glampro_suite
Group=glampro_suite-code
WorkingDirectory=/opt/glampro_suite/current/apps/api
EnvironmentFile=/etc/glampro_suite/production.env
ExecStart=/opt/glampro_suite-runtime/node-v24.21.0/bin/node dist/src/message-worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/glampro_suite

[Install]
WantedBy=multi-user.target
