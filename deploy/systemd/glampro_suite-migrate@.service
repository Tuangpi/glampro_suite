[Unit]
Description=Glampro migration deploy for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=glampro_suite
Group=glampro_suite-code
WorkingDirectory=/opt/glampro_suite/releases/%i/apps/api
EnvironmentFile=/etc/glampro_suite/production.env
Environment=PRISMA_HIDE_UPDATE_MESSAGE=true
Environment=CHECKPOINT_DISABLE=1
ExecStart=/opt/glampro_suite-runtime/node-v24.21.0/bin/node ../../node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts
TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
