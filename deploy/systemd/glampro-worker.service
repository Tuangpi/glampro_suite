[Unit]
Description=Glampro worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glampro
Group=glampro-code
WorkingDirectory=/opt/glampro/current/apps/api
EnvironmentFile=/etc/glampro/production.env
ExecStart=/usr/local/bin/node dist/src/message-worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/glampro

[Install]
WantedBy=multi-user.target
