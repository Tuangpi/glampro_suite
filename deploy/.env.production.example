# Install on VPS as /etc/glampro_suite/production.env, root:root, mode 600.
# systemd EnvironmentFile syntax: KEY=value, no export or shell expansion.
NODE_ENV=production
HOST=127.0.0.1
PORT=9100
DATABASE_URL=postgresql://glampro:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:5432/glampro
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
CORS_ORIGINS=https://salon.example.com
SALON_PORTAL_ORIGIN=https://salon.example.com
UPLOADS_DIR=/var/lib/glampro_suite/uploads
BCRYPT_ROUNDS=12
LOG_LEVEL=info
MESSAGING_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_MAILBOX
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM="Glampro Suite <no-reply@example.com>"
# Add provider/tenant configuration only after explicit messaging activation.

# Optional error monitoring for both API and worker. Use the API project DSN.
# Match SENTRY_RELEASE to the deployed tag, for example v1.0.0.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
