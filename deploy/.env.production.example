# Copy to /opt/glampro/.env.production ON THE VPS, chmod 600. Never commit secrets.
# Pin to the digest inspected on the VPS: docker image inspect postgres:17-bookworm
POSTGRES_IMAGE=postgres:17-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_USER=glampro
POSTGRES_DB=glampro
# Use a URL-safe password, e.g. openssl rand -hex 32. Keep both values identical.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://glampro:REPLACE_WITH_RANDOM_PASSWORD@database:5432/glampro
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
CORS_ORIGINS=https://salon.example.com
SALON_PORTAL_ORIGIN=https://salon.example.com
BCRYPT_ROUNDS=12
LOG_LEVEL=info
MESSAGING_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_MAILBOX
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM='Glampro Suite <no-reply@example.com>'
# Enable only after provider/tenant setup and explicit messaging activation:
# COMPOSE_PROFILES=messaging
# MESSAGING_PUBLIC_ORIGIN=https://salon.example.com
# MESSAGING_TENANTS_JSON='{"tenant-id":{...}}'