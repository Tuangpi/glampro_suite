# Copy to apps/api/.env for host-based development (`npm run dev`).
# Inside Docker these values come from .env.docker at the repository root instead.

NODE_ENV=development
PORT=9000
LOG_LEVEL=debug

# PostgreSQL. Matches the database published by `compose.yaml`
# (POSTGRES_PORT=5433), so `docker compose --env-file .env.docker up -d database`
# is all you need before `npm run dev`.
DATABASE_URL=postgresql://glampro:glampro@localhost:5433/glampro

# Only read by `prisma migrate diff --from-migrations`; point it at a throwaway database.
# SHADOW_DATABASE_URL=postgresql://glampro:glampro@localhost:5433/glampro_shadow

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Defaults to "<JWT_SECRET>-refresh" when unset.
# JWT_REFRESH_SECRET=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted salon web origin for owner invitation links (not the operator portal).
# Production must use HTTPS. Loopback HTTP is allowed for local development.
SALON_PORTAL_ORIGIN=http://localhost:5173

# Directory for user uploads, relative to apps/api.
UPLOADS_DIR=uploads

# bcrypt work factor. Use 12 in production.
BCRYPT_ROUNDS=10

# Seed behaviour: `development` also creates demo staff accounts.
# In production, ADMIN_* initializes the platform administrator, not a salon owner.
# Supply a real email and a private password (12+ characters, at most 72 UTF-8 bytes).
# Production seeds shared modules only; no demo salon or salon users are created.
SEED_MODE=development
# ADMIN_EMAIL=admin@glampro.test
# ADMIN_NAME=Glampro Administrator
# ADMIN_PASSWORD=ChangeMe123!

# Outbound email — 2FA codes and emailed receipts (TK2610-0010).
# In development/test, leaving SMTP_HOST unset keeps messages off the network: the
# API accepts the operation without logging message bodies or verification codes.
# For local 2FA, run a capture-only inbox on loopback and set SMTP_HOST=127.0.0.1,
# SMTP_PORT=1025, SMTP_SECURE=false, with empty SMTP_USER and SMTP_PASSWORD.
# In production an unset SMTP_HOST makes
# email fail with 503 EMAIL_NOT_CONFIGURED rather than silently dropping a receipt.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set SMTP_SECURE=true for implicit TLS (usually port 465). Port 587 uses STARTTLS.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# The From: address. Use a mailbox your provider has authorised.
MAIL_FROM="Glampro Suite <no-reply@example.com>"

# WhatsApp/SMS: OFF until explicit operator activation. See docs/whatsapp-sms-integration.md.
MESSAGING_ENABLED=false
# Public HTTPS origin serving /api, with no path/query. Used for links and signed webhooks.
# MESSAGING_PUBLIC_ORIGIN=https://salon.example.com
# Secret JSON keyed by exact tenant ID; inject through a secret manager, not source control.
# MESSAGING_TENANTS_JSON={"tenant-id":{"accountSid":"AC...","authToken":"...","smsFrom":"RegisteredName","whatsappFrom":"whatsapp:+...","templates":{"CONFIRMATION":"HX...","REMINDER":"HX...","REBOOKING":"HX...","RECEIPT":"HX..."}}}
