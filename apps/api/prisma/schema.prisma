// Glampro data model.
//
// This is the greenfield schema for the Postgres rebuild. Tables are mapped to
// snake_case names (`@@map`) so hand-written reporting SQL stays readable,
// while the Prisma models keep PascalCase like the rest of the codebase.
//
// Phase 0 shipped only the session tables needed to boot and authenticate.
// Phase 2 adds the tenant plane — `PlatformAdmin`, `Tenant`, `Module`,
// `TenantModule`, `Subscription`, `Payment` and `AuditLog` — per
// `docs/saas/TENANCY.md` §2. Catalogue, POS, appointments, staff and reporting
// models land in the second Phase 2 commit, which also gives `User` its
// `tenantId`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Salon-scoped role. Order is intentional: highest privilege first.
enum GlobalRole {
  SUPER_ADMIN
  MANAGER
  STAFF
  CASHIER
}

/// Which client surface a session belongs to.
enum AuthRealm {
  web
  pos
  mobile
}

/// The isolation boundary's lifecycle. Drives what a tenant's users may do —
/// see `docs/saas/TENANCY.md` §6.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

/// An operator of the SaaS itself. Never has a `tenantId`.
enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

/// How a customer paid (TK2610-0011).
///
/// The first five predate the POS phase; the rest were added with local payment
/// methods and redemption. `PAYNOW_SGQR`, `NETS`, `GRABPAY` and `ATOME` are
/// **recorded manually** — the till stores which rail was used and no provider is
/// called. `PACKAGE` and `PREPAID_CREDIT` are tenders that spend credit the
/// customer already holds; the draw is written to `CustomerRedemption` in the same
/// transaction as the sale.
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
  PAYNOW_SGQR
  NETS
  GRABPAY
  ATOME
  PACKAGE
  PREPAID_CREDIT
}

/// Active flag shared by the catalogue. The legacy tables each carried their own
/// `status boolean` with the same `1=active 0=inactive` meaning but a different
/// default, which is why it is explicit everywhere here.
enum CatalogStatus {
  ACTIVE
  INACTIVE
}

/// The booking lifecycle. The legacy system stored a two-state flag and used
/// `finish_time` for completion — see legacy/LEGACY-MAP.md §6 Q8 for the mapping.
enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Free text in the legacy database (a string on `customers`, an integer on
/// `users`). Provisional: what the production rows actually contain is Q5, still
/// open, and the importer maps anything unrecognised to `UNDISCLOSED` rather than
/// guessing.
enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

/// The POS sale lifecycle.
///
/// Legacy `sale_status` was a two-state flag documented as `0=hold, 1=done`. The
/// two legacy states map straight onto `HELD` and `COMPLETED`; `VOID` is the
/// third because a sale that has been paid for and then found to be wrong needs a
/// recorded state, and deleting the row is not one — the receipt has to stay.
enum SaleStatus {
  HELD
  COMPLETED
  VOID
}

/// How a voucher takes money off. `PERCENTAGE` stores 0.01–100 in `Voucher.value`;
/// `FIXED` stores a money amount. Two named kinds rather than a boolean, because a
/// report and the till both need to say which one applied.
enum VoucherDiscountType {
  PERCENTAGE
  FIXED
}

/// Which catalogue row a sale line points at.
///
/// Legacy kept five separate line tables — `sale_products`, `sale_services`,
/// `sale_packages`, `sale_valuepackages` and `sale_gift_cards` — with columns
/// identical apart from which foreign key they carried. The handoff cart (screens
/// 01–02) searches, adds and prices all five kinds identically, so one table with
/// this discriminator is both smaller and closer to what the screen does.
enum SaleLineItemType {
  SERVICE
  PRODUCT
  PACKAGE
  VALUE_PACKAGE
  GIFT_CARD
}

/// Whether the money has changed hands. Legacy `payment_status`, `0=unpaid,
/// 1=paid`, widened into a named pair rather than a tinyint.
enum PaymentStatus {
  UNPAID
  PAID
}

/// Whether a leave request was approved.
///
/// The legacy table had no status column at all: approval was inferable only by
/// reading `granted_by`, which holds either an approver's name or the literal
/// string `"rejected"` (Q9). Naming the outcome means no query has to
/// string-match a person's name.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  /// The isolation boundary. Staff are `User` rows (Q4 in legacy/LEGACY-MAP.md §6),
  /// so this column is what makes a staff member tenant-scoped.
  tenantId     String
  email        String?    @unique
  name         String
  passwordHash String
  /// PIN-only staff cannot create web sessions. Hashes never leave the API.
  posPinHash String?
  posPinVersion Int @default(0)
  globalRole   GlobalRole @default(STAFF)
  phone        String?
  avatar       String?
  disabled     Boolean    @default(false)
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  /// Bumped on logout and password change to invalidate outstanding tokens.
  tokenVersion                  Int        @default(0)
  /// Email-based two-factor authentication. `twoFactorCode` holds the SHA-256
  /// hash of the current one-time code; `twoFactorCodeExpiresAt` is its deadline.
  twoFactorEnabled              Boolean    @default(false)
  twoFactorCode                 String?
  twoFactorCodeExpiresAt        DateTime?
  /// `users.start_date` / `end_date` in the legacy schema.
  startDate DateTime?
  endDate   DateTime?
  /// `users.position` — the free-text job title shown in booking.
  position String?
  /// Percentage of net, tax-exclusive service revenue, snapshotted on completion.
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  /// Calendar colour, from `users.color`. Booking uses it to tint an appointment.
  color        String?
  /// Google Calendar sync fields (`2026_03_16` migration). Stored, not yet acted on.
  googleCalendarId       String?
  googleCalendarSyncToken String?
  googleCalendarExpiresAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  /// Set on exactly one user per tenant. Ownership is a relation, not a role —
  /// see ADR 0002. `Tenant.id` equals this id only for tenants migrated from the
  /// legacy database, and nothing may rely on that.
  ownedTenant  Tenant?     @relation("TenantOwner")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments  StaffDepartment[]
  /// A user with no appointments yet still appears in pickers.
  appointments Appointment[]
  commissions  EmployeeCommission[]
  /// Sales this user rang up, and the lines credited to them. Per-line credit is
  /// the redesign's model — legacy had four fixed `sold_by_one..four` slots on the
  /// sale, which cannot express "these two people shared this one service".
  sales        Sale[] @relation("SaleStaff")
  /// Sales this user voided. An audit trail rather than a work list: the relation exists
  /// so the receipt can print a name, and it is the one `Sale`↔`User` link that does not
  /// cascade ([ADR 0016](../../../PROJECT.md#adr-0016)).
  voidedSales  Sale[] @relation("SaleVoidedBy")
  /// Vouchers this manager created. `SetNull`, so removing an account does not
  /// delete a campaign the salon still honours; the voucher keeps its code and dates.
  createdVouchers Voucher[] @relation("VoucherCreatedBy")
  /// Refunds this manager recorded. The audit trail survives account removal.
  recordedRefunds SaleRefund[] @relation("SaleRefundedBy")
  saleLines    SaleLine[]
  performances EmployeePerformance[]
  leaves       EmployeeLeave[]
  shifts       StaffShift[]

  @@index([globalRole])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the opaque refresh token — the raw value is never stored.
  tokenHash String    @unique
  realm     AuthRealm @default(web)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Tenant plane — docs/saas/TENANCY.md §2
// ---------------------------------------------------------------------------

/// An employee of the SaaS operator. Sits above every tenant and never has a
/// `tenantId`. The `platform` realm that authenticates it lands with the console
/// phase, not here.
model PlatformAdmin {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String
  passwordHash String
  status       PlatformAdminStatus @default(ACTIVE)
  /// Bumped on logout and password change, as on `User`.
  tokenVersion Int                 @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  payments  Payment[]
  auditLogs AuditLog[]

  @@map("platform_admins")
}

/// One salon business. The isolation boundary every domain row points at.
///
/// `id` is `cuid()` for tenants created after the cutover. A tenant migrated from
/// the legacy database keeps its owner's legacy `users.id` verbatim, so every
/// `company_id` is already a valid `tenantId` — see ADR 0002.
model Tenant {
  messagingSettings MessagingSettings?
  channelConsents ChannelConsent[]
  channelConsentEvents ChannelConsentEvent[]
  messageJobs MessageJob[]
  publicLinks PublicLink[]
  id      String       @id @default(cuid())
  name    String
  slug    String       @unique
  status  TenantStatus @default(ACTIVE)
  /// Bumped on suspension, which invalidates every access token for the tenant.
  tokenVersion Int     @default(0)
  /// Stock at or below this is "low", for the Products rail badge and the
  /// `?lowStock=true` filter. Deliberately per tenant rather than a constant:
  /// "low" is a salon's own judgement, and a shop that holds forty bottles of
  /// shampoo does not agree with one that holds four. See ADR 0010.
  lowStockThreshold Int @default(5)
  /// Salon-wide formatting and wall-clock preferences (P0-08).
  timeZone String @default("Asia/Singapore") @map("time_zone")
  locale   String @default("en-SG")
  /// The last receipt number this salon has issued. `receiptNumber` on `Sale` is a
  /// per-tenant sequence rather than legacy's `random_int(100000, 999999)`, which no
  /// constraint protected (ADR 0011).
  ///
  /// A **column on the tenant, not a Postgres sequence**: a `SERIAL` is global, so
  /// two salons would hand out interleaved numbers and each salon would see gaps and
  /// another's figures in its own receipts. The till increments this inside the same
  /// transaction that writes the sale, which is also what makes two tills rung up at
  /// once take different numbers rather than the same one.
  receiptCounter Int @default(0)
  /// GST for Singapore salons (TK2610-0009 / P0-01). Catalogue prices are
  /// GST-inclusive; the till back-calculates the component per line.
  /// Disabled by default so existing salons keep today's behaviour until
  /// a manager opts in from Settings.
  gstEnabled            Boolean @default(false)
  /// The salon's GST registration number, printed on receipts and reports.
  gstRegistrationNumber String?
  /// Snapshot of the rate applied at sale time lives on the sale/line rows,
  /// so a later rate change never rewrites history.
  /// Ownership is this relation. There is deliberately no `OWNER` role.
  ///
  /// Nullable because of a real foreign-key cycle: `users.tenantId` points at
  /// `tenants`, and `tenants.ownerUserId` points back at `users`, so neither row can
  /// be inserted first. A tenant is created with no owner and given one in the
  /// immediately following statement, which is also honest about the bootstrap step
  /// where the first tenant's owner is an administrator account that does not exist
  /// yet. Every path that creates a tenant from the API or the console sets it in the
  /// same request; only the seed writes it in two steps.
  ownerUserId String?   @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner         User?            @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  modules       TenantModule[]
  subscriptions Subscription[]
  payments      Payment[]
  auditLogs     AuditLog[]

  // Every domain model below points back here. ADR 0002 wants `tenantId` to be a
  // real foreign key, so a row that names a tenant that does not exist fails the
  // insert instead of silently reading as "no tenant".
  users               User[]
  departments         Department[]
  staffDepartments    StaffDepartment[]
  customers           Customer[]
  customerDepartments CustomerDepartment[]
  services            Service[]
  products            Product[]
  packages            Package[]
  packageServices     PackageService[]
  valuePackages       ValuePackage[]
  valuePackageServices ValuePackageService[]
  giftCards           GiftCard[]
  appointments        Appointment[]
  employeeCommissions EmployeeCommission[]
  sales               Sale[]
  saleLines           SaleLine[]
  salePayments        SalePayment[]
  packageHoldings     CustomerPackageHolding[]
  valuePackageHoldings CustomerValuePackageHolding[]
  giftCardHoldings    CustomerGiftCardHolding[]
  customerPoints      CustomerPoint[]
  customerOutstandings CustomerOutstanding[]
  outstandingPayments CustomerOutstandingPayment[]
  customerRedemptions CustomerRedemption[]
  employeePerformances EmployeePerformance[]
  employeeLeaves      EmployeeLeave[]
  staffShifts         StaffShift[]
  operatingHours      TenantOperatingHours?
  privacyNotices      PrivacyNotice[]
  consentEvents       CustomerConsentEvent[]
  photos              CustomerPhoto[]
  vouchers            Voucher[]
  voucherRedemptions  VoucherRedemption[]
  saleRefunds         SaleRefund[]
  directStaffTips     DirectStaffTip[]

  @@index([status])
  @@map("tenants")
}

/// The salon's published operating hours, one row per day of the week
/// (`0 = Sunday` ... `6 = Saturday`). Used to generate available appointment
/// slots and to tell customers when the salon is open.
///
/// P0-03 stores one tenant-wide schedule. Multi-outlet hours land in P2-02,
/// which introduces the `outlet` model; until then there is exactly one schedule
/// per salon and `tenantId` is the scope.
model TenantOperatingHours {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  /// Each day is a `null` pair (closed) or an `open`/`close` pair (open).
  /// Monday first in the UI; Sunday at index 0 matches JavaScript's `getDay()`.
  sundayOpen  String?
  sundayClose String?
  mondayOpen  String?
  mondayClose String?
  tuesdayOpen String?
  tuesdayClose String?
  wednesdayOpen String?
  wednesdayClose String?
  thursdayOpen String?
  thursdayClose String?
  fridayOpen String?
  fridayClose String?
  saturdayOpen String?
  saturdayClose String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_operating_hours")
}

/// Both bounds are required when the day is open; a null pair means the day is
/// closed. Times are local wall-clock `HH:mm` values, never instants — a salon
/// at `Asia/Singapore` opens at 09:00 local whatever the host's timezone.

/// The catalogue of switchable features. Seeded, never user-created.
model Module {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String
  /// Core modules need no `TenantModule` row; `requireModule` passes as soon as
  /// the tenant exists.
  isCore    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants TenantModule[]

  @@map("modules")
}

/// One entitlement: this tenant has this module.
model TenantModule {
  id       String    @id @default(cuid())
  tenantId String
  moduleId String
  /// An entitlement past this instant is not effective, even while the row exists.
  expiresAt DateTime?
  /// Per-module caps (seats, transaction counts). Null means "unlimited".
  limits   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@map("tenant_modules")
}

/// One paid period. Several per tenant over time.
model Subscription {
  id        String             @id @default(cuid())
  tenantId  String
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  amount    Decimal            @db.Decimal(12, 2)
  currency  String             @default("USD")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@index([endDate])
  @@map("subscriptions")
}

/// Ledger entry against a subscription.
model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  subscriptionId String?
  /// `Decimal(12,2)`, not the legacy `decimal(8,2)` — that capped a salon at
  /// 999,999.99.
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime
  method    PaymentMethod
  recordedByPlatformAdminId String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant                  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription            Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recordedByPlatformAdmin PlatformAdmin? @relation(fields: [recordedByPlatformAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([paidAt])
  @@map("payments")
}

/// Every privileged platform action. Carries a `tenantId` as a *reference* to
/// what was acted on, not as a scope — the console reads audit rows across every
/// tenant, so this model is deliberately absent from `TENANT_SCOPED_MODELS`.
model AuditLog {
  id                   String    @id @default(cuid())
  actorPlatformAdminId String?
  tenantId             String?
  action               String
  targetType           String
  targetId             String?
  metadata             Json?
  ip                   String?
  createdAt            DateTime  @default(now())

  actor  PlatformAdmin? @relation(fields: [actorPlatformAdminId], references: [id], onDelete: SetNull)
  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Domain — docs/roadmap.md Phase 2. Every model carries a non-null `tenantId`.
// ---------------------------------------------------------------------------

/// A branch or section of the salon. Legacy `departments`, whose `company_id` had
/// no foreign key because the table predates `users`.
model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffDepartment[]
  customers CustomerDepartment[]
  services  Service[]
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

/// Staff ↔ branch. Legacy `department_user`, which had no `company_id` at all and
/// so could not be tenant-scoped on its own; the rebuild gives it one.
model StaffDepartment {
  id           String @id @default(cuid())
  tenantId     String
  userId       String
  departmentId String

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([tenantId])
  @@map("staff_departments")
}

/// A bookable service. Legacy `services`, whose department column was named
/// `department` while `products` used `department_id` for the same relationship.
model Service {
  id             String        @id @default(cuid())
  tenantId       String
  departmentId   String?
  name           String
  status         CatalogStatus @default(ACTIVE)
  memberPrice    Decimal       @db.Decimal(12, 2)
  nonmemberPrice Decimal       @db.Decimal(12, 2)
  /// Loyalty points earned. Legacy `point` (integer).
  points         Int           @default(0)
  description    String?
  /// Minutes. The legacy `services` table had no duration column even though
  /// booking needs one; it lived only on `appointments`.
  durationMinutes Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments       Appointment[]
  packageItems       PackageService[]
  valuePackageItems  ValuePackageService[]

  @@index([tenantId])
  @@index([departmentId])
  @@map("services")
}

/// A stock item. Legacy `products`.
model Product {
  id             String        @id @default(cuid())
  tenantId       String
  departmentId   String?
  name           String
  status         CatalogStatus @default(ACTIVE)
  memberPrice    Decimal       @db.Decimal(12, 2)
  nonmemberPrice Decimal       @db.Decimal(12, 2)
  /// Stock on hand. Legacy `quantity` (integer).
  quantity       Int           @default(0)
  points         Int           @default(0)
  description    String?
  /// Scannable barcode. Null when the product carries none. Stored trimmed
  /// and upper-cased; unique per tenant (see `@@unique` below).
  barcode       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([departmentId])
  /// A barcode identifies one product within one salon. The same barcode may
  /// exist in another salon, so the tenant is part of the key. Postgres treats
  /// NULLs as distinct in a unique index, so products without a barcode are
  /// unconstrained.
  @@unique([tenantId, barcode], map: "products_tenantId_barcode_key")
  @@map("products")
}

/// A bundle of service sessions. Legacy `packages`.
model Package {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  status         CatalogStatus @default(ACTIVE)
  /// Sessions included. Legacy `no_of_time`.
  sessionCount   Int           @default(0)
  memberPrice    Decimal       @db.Decimal(12, 2)
  nonmemberPrice Decimal       @db.Decimal(12, 2)
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services PackageService[]
  customerHoldings CustomerPackageHolding[]

  @@index([tenantId])
  @@map("packages")
}

/// Which services a package covers. Legacy `package_services`.
model PackageService {
  id        String @id @default(cuid())
  tenantId  String
  packageId String
  serviceId String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([tenantId])
  @@map("package_services")
}

/// Prepaid credit: the customer pays `price` and receives `credit` of value, and
/// the difference is the discount. Legacy `valuepackages`.
model ValuePackage {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  status      CatalogStatus @default(ACTIVE)
  price       Decimal       @db.Decimal(12, 2)
  credit      Decimal       @db.Decimal(12, 2)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services ValuePackageService[]
  customerHoldings CustomerValuePackageHolding[]

  @@index([tenantId])
  @@map("value_packages")
}

/// Which services a value package may be spent on. Legacy `valuepackage_services`.
model ValuePackageService {
  id             String @id @default(cuid())
  tenantId       String
  valuePackageId String
  serviceId      String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valuePackage ValuePackage @relation(fields: [valuePackageId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([valuePackageId, serviceId])
  @@index([tenantId])
  @@map("value_package_services")
}

/// A prepaid gift card. Legacy `giftcards`, whose `expired_date` was a **string**
/// and is a real date here; the rule for malformed values is the importer's (Q6).
model GiftCard {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  value     Decimal  @db.Decimal(12, 2)
  /// Null means "never expires". Legacy `expired_date` (string).
  expiresAt DateTime?
  remark    String?
  /// Payload for the client's QR renderer, not an image (legacy `qr_code`).
  qrPayload String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerHoldings CustomerGiftCardHolding[]

  @@index([tenantId])
  @@map("gift_cards")
}

/// A salon customer. Legacy `customers`.
///
/// Two legacy problems are fixed here. `email` was **globally** unique across all
/// tenants, which stopped one person being a customer at two salons — uniqueness is
/// now per tenant (ADR 0003). And `customer_id` was a second identifier the code had
/// to keep in sync with `id`; it becomes `code`, a nullable human-readable label
/// rather than an alternative key.
model MessagingSettings {
  id String @id @default(cuid())
  tenantId String @unique
  whatsappEnabled Boolean @default(false)
  smsEnabled Boolean @default(false)
  reminderHours Int @default(24)
  rebookingDays Int @default(28)
  quietStart Int @default(20)
  quietEnd Int @default(9)
  cancellationHours Int @default(2)
  consentVersion String @default("")
  serviceConsentText String @default("")
  marketingConsentText String @default("")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("messaging_settings")
}

model ChannelConsent {
  id String @id @default(cuid())
  tenantId String
  customerId String
  channel String
  destination String
  service Boolean @default(false)
  marketing Boolean @default(false)
  preferred Boolean @default(false)
  revision Int @default(0)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, customerId, channel])
  @@map("channel_consents")
}

model ChannelConsentEvent {
  id String @id @default(cuid())
  tenantId String
  customerId String
  channel String
  destination String
  service Boolean
  marketing Boolean
  preferred Boolean
  revision Int
  noticeVersion String
  serviceText String
  marketingText String
  actorId String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, customerId, createdAt])
  @@map("channel_consent_events")
}

model MessageJob {
  id String @id @default(cuid())
  tenantId String
  customerId String?
  appointmentId String?
  saleId String?
  revision Int @default(0)
  kind String
  channel String?
  destination String?
  status String @default("PENDING")
  dueAt DateTime
  attempts Int @default(0)
  leaseUntil DateTime?
  providerSid String? @unique
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([status, dueAt])
  @@index([tenantId, createdAt])
  @@map("message_jobs")
}

model PublicLink {
  id String @id @default(cuid())
  tenantId String
  tokenHash String @unique
  kind String
  targetId String
  revision Int @default(0)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, kind, targetId])
  @@map("public_links")
}

model Customer {
  id       String @id @default(cuid())
  tenantId String
  /// Human-readable label shown in the UI. Legacy `customer_id`.
  code     String?
  name     String
  /// Legacy `member_id` — the membership/tier reference.
  memberId String?
  /// Legacy `dob` was a string; it is a date here and the importer normalises it.
  dateOfBirth DateTime?
  gender      Gender?
  /// Unique **per tenant**, not globally. See ADR 0003.
  email       String?
  phone       String?
  /// Physical loyalty cards. Kept as opaque strings: the issuing authority is the
  /// legacy system's business, not ours to validate.
  hairCardNumber String?
  maniCardNumber String?
  cardNumber     String?
  address     String?
  comment     String?
  /// No existing customer is opted in by this migration.
  pdpaConsent Boolean @default(false)
  marketingOptIn Boolean @default(false)
  consentRevision Int @default(0)
  /// Customers can sign in to the mobile app, so the hash lives here and not only
  /// on `User`.
  passwordHash String?
  /// Mobile password reset. Legacy `otp` + `otp_expire_at` (epoch seconds).
  otpHash      String?
  otpExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments  CustomerDepartment[]
  appointments Appointment[]
  sales            Sale[]
  packageHoldings     CustomerPackageHolding[]
  valuePackageHoldings CustomerValuePackageHolding[]
  giftCardHoldings    CustomerGiftCardHolding[]
  customerPoints      CustomerPoint[]
  outstandings        CustomerOutstanding[]
  outstandingPayments CustomerOutstandingPayment[]
  redemptions         CustomerRedemption[]
  consentEvents       CustomerConsentEvent[]
  photos              CustomerPhoto[]

  /// Per-tenant email uniqueness. A customer with no email is unconstrained, which
  /// Postgres treats as satisfying a unique index for every such row.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([name])
  @@map("customers")
}

/// Private raster photos. Content is never exposed through public static uploads.
model CustomerPhoto {
  id String @id @default(cuid())
  tenantId String
  customerId String
  caption String
  mimeType String
  content Bytes
  createdAt DateTime @default(now())
  createdById String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([tenantId, customerId, createdAt])
  @@map("customer_photos")
}

/// Immutable wording; latest row is the current notice.
model PrivacyNotice {
  id String @id @default(cuid())
  tenantId String
  version String
  dataConsentText String
  marketingConsentText String
  createdAt DateTime @default(now())
  createdById String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events CustomerConsentEvent[]
  @@unique([tenantId, version])
  @@index([tenantId, createdAt])
  @@map("privacy_notices")
}

/// Append-only through the API. Actor id survives staff removal; no contact data copied.
model CustomerConsentEvent {
  id String @id @default(cuid())
  tenantId String
  customerId String
  revision Int
  pdpaConsent Boolean
  marketingOptIn Boolean
  recordedAt DateTime @default(now())
  recordedById String
  noticeId String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notice PrivacyNotice? @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  @@unique([customerId, revision])
  @@index([tenantId, customerId])
  @@map("customer_consent_events")
}

/// Customer ↔ branch. Legacy `customer_department`, which had no `company_id`.
model CustomerDepartment {
  id           String @id @default(cuid())
  tenantId     String
  customerId   String
  departmentId String

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([customerId, departmentId])
  @@index([tenantId])
  @@map("customer_departments")
}

/// A booking.
///
/// The legacy row stored `date`, `time` **and** `start_time`; reading the
/// controllers settled that `start_time` is the authoritative one and the other two
/// are copies written from the same input (Q7, [`legacy/LEGACY-MAP.md`](legacy/LEGACY-MAP.md)
/// §6). Only the timestamp survives here, so the copies cannot drift.
///
/// `status` replaces a boolean that never had more than two meaningful values
/// (`0` booked, `1` started) while completion was recorded by setting `finish_time`
/// (Q8). Both halves of that are now one column, and `finishedAt` keeps the moment.
model Appointment {
  messageRevision Int @default(0)
  customerConfirmedAt DateTime?
  id          String            @id @default(cuid())
  tenantId    String
  customerId  String?
  staffId     String?
  serviceId   String?
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(SCHEDULED)
  /// Minutes, copied from the service at booking time so a later catalogue edit
  /// does not silently move an existing appointment.
  durationMinutes Int?
  comment     String?
  /// Set by `appointmentFinish`, alongside `finishedAt`. Legacy `signature` was
  /// added by the `2025_07_16` migration.
  signature  String?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    User?     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@index([staffId, startsAt])
  @@map("appointments")
}

/// A staff member's cut of a sale. Legacy `employee_comissions`, whose
/// `sale_amount` was an **integer** and therefore truncated cents; the rate is a
/// percentage so the amount is derived rather than stored.
model EmployeeCommission {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  saleId   String?
  /// Percentage of the sale, e.g. `15.50`.
  rate     Decimal @db.Decimal(5, 2)
  /// Derived at sale time and stored so a later rate change does not rewrite history.
  amount   Decimal @db.Decimal(12, 2)
  paidAt DateTime?
  refundAdjustment Boolean @default(false)
  reconciliationRequired Boolean @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional: a commission can be booked against a period rather than a single
  /// sale. A commissioned line still points at its sale.
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("employee_commissions")
}
/// A sale.
///
/// Four deliberate departures from legacy `sales`, each recorded in
/// `legacy/LEGACY-MAP.md` §4:
///
/// 1. **`paymenttype_id` is gone.** It pointed at a table no migration created,
///    carried no constraint and was never assigned (Q1). `paymentMethod` types the
///    live `payment_type` text against the enum that already existed.
/// 2. **`sale_date` + `sale_time` become `soldAt`.** One timestamp, so the two
///    copies that could disagree cannot.
/// 3. **`sold_by_one..four` are gone.** Four fixed slots cannot express the
///    redesign's per-line attribution, so credit lives on `SaleLine.staffId` and
///    `staffId` here is simply who rang it up.
/// 4. **`sale_id` (a string used as the pivot key) is gone.** Lines key on this
///    row's own id.
/// 5. **`payment_type` and `session_id` moved to `SalePayment`.** Legacy held one
///    tender per sale, so `splitPay()` stored the string `"cash_50_card_25"` in the
///    text column — a sale no report can sum. The tenders are rows now (ADR 0012).
model Sale {
  id       String @id @default(cuid())
  tenantId String
  /// Optional: a walk-in sale has no customer row, and forcing one would mean
  /// inventing a "cash customer" per salon. Legacy made this column non-null.
  customerId String?
  /// Who rang the sale up. Per-line credit is on `SaleLine.staffId`.
  staffId    String?
  status     SaleStatus @default(HELD)

  totalQuantity Int
  totalAmount   Decimal @db.Decimal(12, 2)
  paidAmount    Decimal @db.Decimal(12, 2)

  /// GST included in the total, as money (TK2610-0009 / P0-01). Inclusive
  /// prices, so this is the back-calculated component summed over the lines,
  /// stored so a later rate change cannot rewrite history. `0` when disabled.
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  /// The GST rate applied, snapshotted at sale time. `0` when disabled.
  taxRate   Decimal @default(0) @db.Decimal(5, 2)

  /// Legacy `payment_status` (`0=unpaid, 1=paid`).
  paymentStatus PaymentStatus @default(UNPAID)

  /// The reference the screen prints — legacy's `sales.sale_id`, which
  /// `random_int(100000, 999999)` wrote and no constraint protected. This is a
  /// per-tenant sequence instead (ADR 0011), so it is unique per salon and
  /// allocated inside the write.
  ///
  /// Nullable because a row that predates the column — a migrated sale, or one
  /// written while the importer is still running — has no number yet, and inventing
  /// one on read would be worse than saying "not assigned".
  receiptNumber Int?

  /// **Q16.** The till's key for this write. A double-tap posts the same key twice
  /// and the second one reads back the sale the first already made, rather than
  /// charging the customer again. Unique per tenant; a `null` key (the legacy
  /// importer) is unconstrained, which Postgres allows for any number of rows.
  idempotencyKey String?

  /// Legacy `sale_date` + `sale_time`.
  soldAt   DateTime
  note     String?
  /// **Q32.** When a `VOID` sale was voided, so the receipt can say so.
  voidedAt DateTime?
  /// Why, in the words of whoever voided it. Free text and required at the API boundary,
  /// nullable here because a sale that was never voided has no reason and a back-fill
  /// would be inventing one ([ADR 0016](../../../PROJECT.md#adr-0016)).
  voidReason String?
  /// Who answered for it — the verified JWT's user, never anything the request named.
  voidedById String?
  /// The salon's GST registration number, snapshotted when the sale is
  /// completed (TK2610-0010). Stored rather than joined so a reprint or an
  /// emailed copy shows the number that applied at the time, even after the
  /// salon's setting changes. `null` when GST was disabled or the row predates
  /// the column.
  gstRegistrationNumber String?
  /// The voucher code the customer presented, snapshotted here so the receipt keeps
  /// saying why the total was lower even if the voucher row is later archived
  /// (ADR 0020). `null` for the ordinary sale nobody vouchered.
  voucherCode           String?
  /// What the voucher took off the **sale**, after the per-line allocation. The lines
  /// carry their share in `SaleLine.voucherDiscountAmount`; this is the figure the
  /// receipt and the refund read, so no caller has to re-add the allocation.
  voucherDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff      User?    @relation("SaleStaff", fields: [staffId], references: [id], onDelete: Restrict)
  /// Receipt customer/cashier/performer links restrict deletion. Void actor remains
  /// `SetNull`: deleting a
  /// departing manager must not delete the sales they voided. The reason column and the
  /// `VOID` status keep the record either way.
  voidedBy   User?    @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  lines      SaleLine[]
  payments    SalePayment[]
  commissions EmployeeCommission[]
  points      CustomerPoint[]
  outstanding CustomerOutstanding?
  outstandingPayments CustomerOutstandingPayment[]
  redemptions CustomerRedemption[]
  performances EmployeePerformance[]
  /// The one voucher this sale consumed. Unique through `VoucherRedemption.saleId`,
  /// so a second voucher on one sale is refused by the database rather than by a
  /// service check two tills could race past.
  voucherRedemption VoucherRedemption?
  /// The one full-sale refund recorded against it, if any (ADR 0020). A refund is an
  /// appended record, never an edit to this row's totals or tenders.
  refund SaleRefund?
  directStaffTips DirectStaffTip[]

  /// One receipt reference per salon. Legacy wrote `random_int(100000, 999999)`
  /// into a nullable string with **no constraint at all**, so two sales could share
  /// a printed number (ADR 0011). A `null` is unconstrained, which is what lets a
  /// migrated sale sit here before the importer assigns one.
  @@unique([tenantId, receiptNumber])
  /// Q16. The same nullability argument: the importer posts without a key, and any
  /// number of unkeyed sales may coexist.
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, soldAt])
  @@index([tenantId, status])
  @@index([customerId, soldAt])
  @@map("sales")
}

/// One tender a sale was paid with.
///
/// Legacy had one `payment_type` text and one `session_id` on the sale row, which
/// can express exactly **one** tender. `splitPay()` charged the card half through
/// Stripe and then stored the whole thing as the free text `"cash_50_card_25"` in
/// `sales.payment_type`, so a split sale could not be summed, counted or reported by
/// any query. It is one row per tender here, and a split is two rows rather than a
/// special case (ADR 0012).
///
/// `sessionId` moves off the sale row onto the tender it belongs to: with one
/// `sales.session_id` there was no way to say which half of a split a gateway
/// session paid for.
model SalePayment {
  id       String @id @default(cuid())
  tenantId String
  saleId   String

  /// Typed against the `PaymentMethod` enum rather than stored as legacy's free
  /// text, so `sum(amount) where method = CASH` is a query rather than a guess about
  /// spelling. The importer maps legacy's text onto this enum.
  method PaymentMethod
  amount Decimal        @db.Decimal(12, 2)

  /// Gateway session, for a card tender that settles later.
  sessionId String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("sale_payments")
}

/// One priced line of a sale — the cart row.
///
/// Legacy had five line tables with the same columns; they are one table here
/// with `itemType` saying which catalogue the `itemId` refers to.
///
/// **`itemId` deliberately has no foreign key.** A polymorphic reference cannot
/// be one, and five nullable columns each pointing at a different table would be
/// the legacy mistake repeated in a new dialect. The application resolves the id
/// against the table named by `itemType`; `itemName` is the snapshot taken at
/// sale time, exactly as legacy stored `name` on every line, so a receipt still
/// reads correctly after the catalogue row is renamed or archived.
model SaleLine {
  id       String @id @default(cuid())
  tenantId String
  saleId   String

  itemType SaleLineItemType
  itemId   String
  itemName String

  quantity Int
  /// The line's place in the cart, 0-based.
  ///
  /// The cart is an ordered list and the receipt has to reprint it **in the order it
  /// was rung up** — a customer disputing line three needs to see the same line
  /// three. Legacy had five line tables and no order in any of them, so it could
  /// only ever print them per-kind.
  ///
  /// Stored rather than derived from `createdAt`: a whole cart is written in one
  /// statement, so every row carries the same timestamp and the receipt would come
  /// back in an arbitrary order.
  position Int @default(0)
  /// What one unit sold for after any discount. Legacy's single `paid_price`
  /// column is ambiguous about whether it is per unit or per line (Q27); both are
  /// stored so the schema is right under either answer, and the importer fills
  /// whichever it can prove.
  unitPrice Decimal @db.Decimal(12, 2)
  /// `quantity * unitPrice`, stored rather than derived so a later edit to either
  /// factor cannot silently rewrite a historical total.
  lineTotal Decimal @db.Decimal(12, 2)

  /// **Q33.** The rate the till applied, recorded so a receipt can say *why* a line is
  /// cheap and a report can add up what the salon gave away — the two things legacy's
  /// unrecorded discount could not answer. `0.00` for a line nobody discounted, so the
  /// column is never null and `SUM` over it works
  /// ([ADR 0017](../../../PROJECT.md#adr-0017)).
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  /// What that rate took off the **whole line**, stored for the same reason `lineTotal`
  /// is: a later reconsideration of the rate must not rewrite a historical figure. The
  /// rate rounds to the cent on the *unit* price, so this is `(listPrice - unitPrice) *
  /// quantity` and the line's own arithmetic stays exact.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// The voucher's share of the reduction, allocated to this line by the service
  /// (ADR 0020). Kept apart from `discountAmount`, which is the cashier's manual
  /// rate: D1 forbids the two on one sale, and the receipt must say which one it
  /// was. `lineTotal` stays the pre-voucher line; the net is
  /// `lineTotal - voucherDiscountAmount`.
  voucherDiscountAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Null for historical rows; new completions snapshot the L2 calculation.
  loyaltyBasePoints Int?
  loyaltyOriginalAmount Decimal? @db.Decimal(12, 2)
  loyaltyNetAmount Decimal? @db.Decimal(12, 2)
  loyaltyAwardedPoints Int?

  /// GST included in this line, as money (TK2610-0009 / P0-01). Inclusive
  /// prices, so `lineTotal × rate / (100 + rate)`, rounded to the cent on
  /// the line. `0` when the salon has GST disabled.
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  /// The GST rate applied to this line, snapshotted at sale time.
  taxRate   Decimal @default(0) @db.Decimal(5, 2)

  /// Who this line is credited to. Null means uncredited — a product sale with no
  /// stylist on it, which is the common case.
  staffId   String?
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staff   User?  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  packageHolding      CustomerPackageHolding[]
  valuePackageHolding CustomerValuePackageHolding[]
  giftCardHolding     CustomerGiftCardHolding[]

  @@index([tenantId])
  @@index([saleId])
  @@index([tenantId, itemType])
  @@map("sale_lines")
}
/// Sessions a customer bought and has not yet spent. Legacy `customer_packages`.
///
/// The three holding tables stay three rather than collapsing into one because
/// they hold genuinely different things: this counts sessions, the value-package
/// holding counts money, and the gift-card holding is money plus a code that
/// identifies it at the till. One table would be nullable in every column.
model CustomerPackageHolding {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  packageId  String
  /// The line that granted it. Legacy reached the sale through `sale_package_id`,
  /// a row that no longer exists separately.
  saleLineId String?

  /// Sessions granted, and how many are left. Reduced by `CustomerRedemption`.
  quantity          Int
  quantityRemaining Int
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package  Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  saleLine SaleLine? @relation(fields: [saleLineId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_package_holdings")
}

/// Money a customer bought against a value package. Legacy `customer_valuepackages`.
model CustomerValuePackageHolding {
  id             String  @id @default(cuid())
  tenantId       String
  customerId     String
  valuePackageId String
  saleLineId     String?

  /// Legacy `amount`. Widened from `decimal(8,2)`, which capped a holding at
  /// 99,999.99.
  amount          Decimal   @db.Decimal(12, 2)
  amountRemaining Decimal   @db.Decimal(12, 2)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  valuePackage ValuePackage @relation(fields: [valuePackageId], references: [id], onDelete: Cascade)
  saleLine     SaleLine?    @relation(fields: [saleLineId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_value_package_holdings")
}

/// A gift card a customer holds. Legacy `customer_giftcards`.
model CustomerGiftCardHolding {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  giftCardId String
  saleLineId String?

  /// Legacy `value`.
  value          Decimal   @db.Decimal(12, 2)
  valueRemaining Decimal   @db.Decimal(12, 2)
  /// Legacy `qr_code`. Opaque: the issuing authority is the legacy system's
  /// business, so this is stored and never interpreted.
  reference  String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  saleLine SaleLine? @relation(fields: [saleLineId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_gift_card_holdings")
}

/// Points earned. Legacy `customer_points`, one row per sale.
///
/// An append-only ledger rather than a balance on the customer: the balance is
/// `SUM(point)`, so correcting a mistaken earn is an offsetting row and never an
/// edit to history.
model CustomerPoint {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  saleId     String?

  /// Signed: a refund or a correction writes a negative row rather than editing
  /// the original. Legacy stored a plain integer.
  point     Int
  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_points")
}
/// What a customer still owes on a sale. Legacy `customer_outstandings`.
model CustomerOutstanding {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  /// Unique: a sale has at most one outstanding balance against it. Legacy left
  /// `sale_id` nullable and unconstrained, so duplicates were possible.
  saleId String? @unique

  /// Legacy `unpaid_amount` — widened from `decimal(8,2)`.
  unpaidAmount Decimal  @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Legacy `customer_paid_outstandings`, a separate table keyed off this row. It
  /// is a child of the outstanding, so it belongs under it.
  payments CustomerOutstandingPayment[]

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_outstandings")
}

/// A payment against an outstanding balance. Legacy `customer_paid_outstandings`.
///
/// Legacy stored `paid_date` and `paid_time` separately; one timestamp here.
model CustomerOutstandingPayment {
  id            String  @id @default(cuid())
  tenantId      String
  customerId    String
  outstandingId String
  saleId        String?

  paidAmount Decimal   @db.Decimal(12, 2)
  paidAt     DateTime
  note       String?
  createdAt  DateTime  @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  outstanding CustomerOutstanding @relation(fields: [outstandingId], references: [id], onDelete: Cascade)
  sale        Sale?              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([outstandingId])
  @@map("customer_outstanding_payments")
}

/// A holding spent against a sale.
///
/// The legacy system had three tables here — `customer_used_packages`,
/// `customer_used_valuepackages` and `customer_used_giftcards` — that differ only
/// in which catalogue the id points at and in one extra column. That is one event
/// with a discriminator, so it is one table.
///
/// It points at the **catalogue item**, not at the holding row. The balance lives
/// on the holding, and reporting asks "how many of this package were spent", not
/// "which of the four rows a customer bought it through".
model CustomerRedemption {
  id         String @id @default(cuid())
  tenantId   String
  customerId String
  saleId     String

  itemType SaleLineItemType
  itemId   String

  /// Sessions drawn for a package redemption; `1` for the money kinds.
  quantity Int     @default(1)
  /// Money drawn, for the two money kinds. Null for a package session.
  amount Decimal? @db.Decimal(12, 2)
  /// Legacy `use_date` + `use_time`, plus the nullable `unuse_time` that recorded
  /// when a session was given back — the same instant, so it is `revertedAt`.
  usedAt     DateTime
  revertedAt DateTime?
  /// Legacy `signature`, a longText the till wrote. Opaque, stored as-is.
  signature  String?
  /// The holding this draw came from, so voiding the sale can put it back.
  ///
  /// A polymorphic reference rather than a foreign key: a session comes from
  /// `CustomerPackageHolding` and money from `CustomerValuePackageHolding`, and one
  /// nullable column cannot point at both. Nullable because a legacy redemption —
  /// and one whose holding has since been deleted — has no row to name.
  holdingId  String?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, itemType, itemId])
  @@index([tenantId, holdingId])
  @@map("customer_redemptions")
}
/// A manager-created promotion the till can apply to one sale (ADR 0020).
///
/// A voucher is **not** a tender and **not** a manual line discount. It is a
/// sale-level reduction the salon publishes in advance: percentage or fixed money,
/// with a validity window, a minimum eligible spend and an optional total redemption
/// limit. Only SERVICE and PRODUCT lines are eligible; packages, prepaid credit and
/// gift cards are excluded because discounting them would discount the credit they
/// grant, which is money the salon has not earned yet.
model Voucher {
  id          String              @id @default(cuid())
  tenantId    String
  /// What the customer says or types at the till. Upper-cased by the service, so two
  /// spellings of one code cannot become two vouchers.
  code        String
  description String?
  discountType VoucherDiscountType
  /// A percentage (`PERCENTAGE`, 0.01–100) or a money amount (`FIXED`). One column
  /// because only one kind applies, and the discriminator says how to read it.
  value       Decimal             @db.Decimal(12, 2)
  startsAt    DateTime
  endsAt      DateTime
  /// The minimum **eligible** line total, after any manual discount. Manual discounts
  /// and vouchers cannot be combined (D1), so in practice this is the services and
  /// products part of the cart.
  minSpend    Decimal             @default(0) @db.Decimal(12, 2)
  /// Total redemptions allowed across all sales; `null` is unlimited. Enforced by a
  /// count-guarded update at completion, so two tills cannot spend the last one twice.
  maxRedemptions Int?
  /// How many completed sales have consumed it. Only a full void gives one back; a
  /// refund does not (R1), because the customer kept the discount they were given.
  redeemedCount  Int               @default(0)
  /// A switched-off voucher stays for history but is refused by the till.
  isActive    Boolean             @default(true)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("VoucherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions VoucherRedemption[]

  /// One row per code per salon. Case is normalised before insert, so the index is
  /// the case-insensitive uniqueness the till needs.
  @@unique([tenantId, code])
  @@index([tenantId, startsAt, endsAt])
  @@map("vouchers")
}

/// One sale's consumption of a voucher.
///
/// `saleId` is unique: a sale takes **one** voucher (V1), and the database is what
/// enforces it. The row is the audit trail and the redemption counter's source of
/// truth; a full void stamps `revertedAt` and gives the count back, while a refund
/// leaves it consumed.
model VoucherRedemption {
  id        String   @id @default(cuid())
  tenantId  String
  voucherId String
  saleId    String   @unique
  /// The money the voucher took off this sale, snapshotted so a later edit to the
  /// voucher cannot rewrite what the customer was given.
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  /// Set by a full void, never by a refund (ADR 0020).
  revertedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, voucherId])
  @@map("voucher_redemptions")
}

/// Evidence of voluntary money paid directly to one staff member, not the salon.
/// Separate from tenders and all sale accounting. A full return preserves this row.
model DirectStaffTip {
  id String @id @default(cuid())
  tenantId String
  saleId String
  idempotencyKey String
  amount Decimal @db.Decimal(12, 2)
  /// IDs and names are audit snapshots, not cascading staff relations.
  staffId String
  staffName String
  recordedById String
  recordedByName String
  recordedAt DateTime @default(now())
  returnedAt DateTime?
  returnedById String?
  returnedByName String?
  returnReason String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId, recordedAt])
  @@map("direct_staff_tips")
}

/// A recorded full-sale refund (ADR 0020 / R1), not a void or a money transfer.
/// Original sale/tenders stand. One refund per sale; verified actor and required reason.
model SaleRefund {
  id        String   @id @default(cuid())
  tenantId  String
  saleId    String   @unique
  /// What was refunded: the sale's `totalAmount`, snapshotted here.
  amount    Decimal  @db.Decimal(12, 2)
  /// Actual money payout split. Null only for records predating P1.
  payouts Json?
  reason    String
  /// The manager's explicit choice. `true` puts PRODUCT lines back on the shelf;
  /// `false` leaves stock as it is (goods not returned, or already accounted for).
  restocked Boolean
  refundedById String?
  refundedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale       Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// `SetNull`, like the void actor: deleting a departing manager must not delete
  /// the refund record or the sale it belongs to.
  refundedBy User?  @relation("SaleRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)

  @@index([tenantId, refundedAt])
  @@map("sale_refunds")
}

/// What a staff member sold, per sale, for the performance report.
///
/// Legacy `employee_performances`. `item_id` and `type` were both nullable
/// strings with no constraint; here the type is an enum and the id is the
/// polymorphic catalogue reference `SaleLine` already uses, so the two agree.
model EmployeePerformance {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  saleId   String

  itemType SaleLineItemType
  itemId   String?
  /// Legacy `amount` was an **integer**, so any fraction was truncated.
  amount    Decimal  @db.Decimal(12, 2)
  refundAdjustment Boolean @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([saleId])
  @@map("employee_performances")
}

/// A staff absence. Legacy `employee_leaves`.
///
/// `from_date` and `to_date` were nullable **strings** there, so the importer has
/// to parse them (Q6); they are dates here. `am_pm` disambiguated a half-day and
/// is kept, because dropping it would merge a morning leave with a full day's.
///
/// Approval was stored lossily in `granted_by` (Q9): it holds either an approver's
/// name or the literal string `"rejected"`. That is not a reliable key, so it is
/// kept as the free text it is, and `status` states the outcome plainly rather
/// than string-matching somebody's name.
model EmployeeLeave {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  fromDate DateTime?
  toDate   DateTime?
  /// Legacy `am_pm` — `AM`, `PM` or `FULLDAY`. Free text in the legacy table.
  halfDay  String?
  /// Derivable from `grantedBy` only by string-matching a name, which is why it
  /// is explicit here (Q9).
  status    LeaveStatus @default(PENDING)
  /// Legacy `granted_by` — an approver's name, or `"rejected"`. Preserved
  /// verbatim; it is not a foreign key and must not be treated as one.
  grantedBy String?
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, fromDate])
  @@map("employee_leaves")
}

/// What one row of the rota is. A break is a **negative** interval inside a work
/// shift, kept as a row of the same table rather than as an array on the shift,
/// so "does this booking fit inside the person's day" is one rule over one set of
/// intervals instead of two rules over two shapes.
enum ShiftKind {
  WORK
  BREAK
}

/// A published shift — legacy had **no rota table at all** (`employee_leaves` was
/// the whole absence surface, and no route in the 154-route inventory reads a
/// schedule), so this is a deliberate model rather than a transcription of one.
///
/// **Wall clock, not an instant.** "9:00 AM – 6:00 PM" is true every Tuesday the
/// salon is open and means a different UTC instant in every month and every
/// timezone, so the row holds minutes since local midnight and a day of the week.
/// A `DateTime` here would pin a recurring rota to one specific Tuesday forever.
/// See ADR 0019.
///
/// `dayOfWeek` is **0 = Sunday**, matching JavaScript's `Date#getDay()`, which is
/// the only thing that reads this column. The calendar grid is Monday-first, but
/// that is a presentation order the client applies; numbering the stored value
/// ISO-style for one view's convenience would make every other reader off by one.
///
/// No row may cross midnight (`startsAtMinute < endsAtMinute`, enforced in the
/// contract): the calendar's 08:00–20:00 gutter would draw an overnight shift as
/// nothing on both of its days, and a row the API accepts but no screen can show
/// is the silent hole ADR 0018 §5 refused.
model StaffShift {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  /// 0 = Sunday … 6 = Saturday.
  dayOfWeek Int
  /// Minutes since local midnight. 0…1440, so 1440 is how "ends at midnight" is
  /// written rather than as an instant on the next day.
  startsAtMinute Int
  endsAtMinute   Int
  kind           ShiftKind @default(WORK)

  /// When this published rota starts applying. Null = it always has.
  ///
  /// A window rather than a bare row is what lets a salon publish next month's
  /// rota without overwriting this month's, and it is what a dated-override
  /// layer would hang off without rewriting existing rows.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The read the availability gate makes: one performer, one weekday. Ordered so
  /// a day's intervals come back already sorted for the containment walk.
  @@index([tenantId, userId, dayOfWeek, startsAtMinute])
  @@index([tenantId, dayOfWeek])
  @@map("staff_shifts")
}
