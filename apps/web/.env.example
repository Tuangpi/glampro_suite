# Copy to apps/web/.env.local for host-based development.
# Anything prefixed with VITE_ is embedded in the browser bundle — never put a
# secret here.

# Base path the browser uses for API calls. Leave as /api so the Vite dev proxy
# (and nginx in production) forward to the API on the same origin.
VITE_API_URL=/api

# Where the Vite dev server forwards /api and /uploads. Must match `PORT` in
# apps/api/.env — 9000 in the template, and something else on a host where 9000
# is already taken. Read from this file (or the environment) by vite.config.ts.
VITE_PROXY_TARGET=http://localhost:9000

# Optional browser error monitoring (public DSN, NOT an auth token).
# These values are embedded at build time. Blank DSN disables monitoring.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
