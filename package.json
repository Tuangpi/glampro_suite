{
  "name": "glampro_suite",
  "version": "0.1.0",
  "private": true,
  "description": "Glampro Suite \u2014 salon management platform. React + TypeScript web app, Express + TypeScript API, PostgreSQL.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n shared,api,web -c blue,green,magenta \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev --workspace @glampro_suite/shared",
    "dev:api": "npm run dev --workspace @glampro_suite/api",
    "dev:web": "npm run dev --workspace @glampro_suite/web",
    "build": "npm run build:shared && npm run db:generate && npm run build:api && npm run build:web",
    "build:shared": "npm run build --workspace @glampro_suite/shared",
    "build:api": "npm run build --workspace @glampro_suite/api",
    "build:web": "npm run build --workspace @glampro_suite/web",
    "clean": "npm run clean --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @glampro_suite/api",
    "db:migrate": "npm run db:migrate --workspace @glampro_suite/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @glampro_suite/api",
    "db:migrate:status": "npm run db:migrate:status --workspace @glampro_suite/api",
    "db:seed": "npm run db:seed --workspace @glampro_suite/api",
    "db:seed:prod": "npm run db:seed:prod --workspace @glampro_suite/api",
    "db:reset": "npm run db:reset --workspace @glampro_suite/api",
    "db:studio": "npm run db:studio --workspace @glampro_suite/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run db:generate && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "predev": "npm run build:shared && npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  }
}
